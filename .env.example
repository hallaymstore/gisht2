# Server
PORT=3939
HOST=127.0.0.1
APP_URL=http://localhost:3939

# IMPORTANT: OAuth tokenlarni AES-256-GCM bilan shifrlash uchun uzun random secret.
APP_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_32_CHARS_OR_MORE

# Telefon / internet orqali ochsangiz ALBATTA panel paroli qo'ying.
# Lokal 127.0.0.1 rejimida bo'sh qoldirish mumkin.
PANEL_PASSWORD=
TRUST_PROXY=0
FORCE_SECURE_COOKIE=0

# Google Cloud OAuth 2.0 Web client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3939/auth/google/callback

# AI provider: gemini | ollama | template
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Local/no-key AI
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Optional: Android/Linux/Termux yoki custom FFmpeg binary uchun
FFMPEG_PATH=
FFPROBE_PATH=

# Render / Cloud
CLOUD_MODE=0
DATABASE_URL=
PGSSL=0
DATA_DIR=
